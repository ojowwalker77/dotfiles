{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Obsidian",
  "author": "Custom",
  "themes": [
    {
      "name": "Obsidian",
      "appearance": "dark",
      "style": {
        "background": "#000000",
        "foreground": "#ffffff",
        "text": "#ffffff",
        "text.muted": "#888888",
        "text.accent": "#1DCD9F",
        "text.disabled": "#444444",

        "element.background": "#111111",
        "element.hover": "#222222",
        "element.active": "#333333",
        "element.selected": "#1DCD9F33",
        "element.disabled": "#181818",

        "surface.background": "#000000",
        "elevated_surface.background": "#111111",

        "border": "#222222",
        "border.focused": "#1DCD9F",
        "border.selected": "#1DCD9F",
        "border.disabled": "#181818",
        "border.variant": "#222222",
        "border.transparent": "#00000000",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#222222",
        "ghost_element.active": "#333333",
        "ghost_element.selected": "#1DCD9F33",
        "ghost_element.disabled": "#181818",

        "drop_target.background": "#1DCD9F33",

        "scrollbar.thumb.background": "#33333366",
        "scrollbar.thumb.hover_background": "#444444aa",
        "scrollbar.thumb.border": "#33333300",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#222222",

        "tab_bar.background": "#000000",
        "tab.inactive_background": "#000000",
        "tab.active_background": "#111111",

        "toolbar.background": "#000000",
        "title_bar.background": "#000000",
        "title_bar.inactive_background": "#000000",
        "status_bar.background": "#000000",
        "panel.background": "#000000",
        "panel.focused_border": "#1DCD9F",

        "pane.focused_border": "#1DCD9F",

        "icon": "#888888",
        "icon.muted": "#555555",
        "icon.disabled": "#333333",
        "icon.placeholder": "#555555",
        "icon.accent": "#1DCD9F",

        "link_text.hover": "#1DCD9F",

        "error": "#ff6b6b",
        "error.background": "#ff6b6b22",
        "error.border": "#ff6b6b",
        "warning": "#ffc107",
        "warning.background": "#ffc10722",
        "warning.border": "#ffc107",
        "success": "#1DCD9F",
        "success.background": "#1DCD9F22",
        "success.border": "#1DCD9F",
        "info": "#1DCD9F",
        "info.background": "#1DCD9F22",
        "info.border": "#1DCD9F",
        "hint": "#169976",
        "hint.background": "#16997622",
        "hint.border": "#169976",

        "conflict": "#ffffff",
        "conflict.background": "#ffffff22",
        "conflict.border": "#ffffff",
        "created": "#1DCD9F",
        "created.background": "#1DCD9F22",
        "created.border": "#1DCD9F",
        "deleted": "#555555",
        "deleted.background": "#55555522",
        "deleted.border": "#555555",
        "hidden": "#333333",
        "hidden.background": "#33333322",
        "hidden.border": "#333333",
        "ignored": "#333333",
        "ignored.background": "#33333322",
        "ignored.border": "#333333",
        "modified": "#169976",
        "modified.background": "#16997622",
        "modified.border": "#169976",
        "renamed": "#1DCD9F",
        "renamed.background": "#1DCD9F22",
        "renamed.border": "#1DCD9F",

        "predictive": "#555555",
        "predictive.background": "#55555522",
        "predictive.border": "#555555",

        "unreachable": "#444444",
        "unreachable.background": "#44444422",
        "unreachable.border": "#444444",

        "editor.foreground": "#ffffff",
        "editor.background": "#000000",
        "editor.gutter.background": "#000000",
        "editor.subheader.background": "#111111",
        "editor.active_line.background": "#111111",
        "editor.highlighted_line.background": "#1DCD9F22",
        "editor.line_number": "#444444",
        "editor.active_line_number": "#ffffff",
        "editor.invisible": "#333333",
        "editor.wrap_guide": "#222222",
        "editor.active_wrap_guide": "#333333",
        "editor.document_highlight.read_background": "#1DCD9F22",
        "editor.document_highlight.write_background": "#1DCD9F33",

        "search.match_background": "#1DCD9F44",

        "terminal.background": "#000000",
        "terminal.foreground": "#ffffff",
        "terminal.bright_foreground": "#ffffff",
        "terminal.dim_foreground": "#888888",
        "terminal.ansi.black": "#222222",
        "terminal.ansi.bright_black": "#555555",
        "terminal.ansi.dim_black": "#111111",
        "terminal.ansi.red": "#ff6b6b",
        "terminal.ansi.bright_red": "#ff8a8a",
        "terminal.ansi.dim_red": "#cc5555",
        "terminal.ansi.green": "#1DCD9F",
        "terminal.ansi.bright_green": "#4de8be",
        "terminal.ansi.dim_green": "#169976",
        "terminal.ansi.yellow": "#ffc107",
        "terminal.ansi.bright_yellow": "#ffd54f",
        "terminal.ansi.dim_yellow": "#cc9a00",
        "terminal.ansi.blue": "#1DCD9F",
        "terminal.ansi.bright_blue": "#4de8be",
        "terminal.ansi.dim_blue": "#169976",
        "terminal.ansi.magenta": "#169976",
        "terminal.ansi.bright_magenta": "#1DCD9F",
        "terminal.ansi.dim_magenta": "#117755",
        "terminal.ansi.cyan": "#1DCD9F",
        "terminal.ansi.bright_cyan": "#4de8be",
        "terminal.ansi.dim_cyan": "#169976",
        "terminal.ansi.white": "#cccccc",
        "terminal.ansi.bright_white": "#ffffff",
        "terminal.ansi.dim_white": "#888888",

        "players": [
          { "cursor": "#1DCD9F", "background": "#1DCD9F33", "selection": "#1DCD9F44" },
          { "cursor": "#169976", "background": "#16997633", "selection": "#16997644" },
          { "cursor": "#4de8be", "background": "#4de8be33", "selection": "#4de8be44" },
          { "cursor": "#ffffff", "background": "#ffffff33", "selection": "#ffffff22" }
        ],

        "syntax": {
          "attribute": { "color": "#1DCD9F" },
          "boolean": { "color": "#1DCD9F" },
          "comment": { "color": "#555555", "font_style": "italic" },
          "comment.doc": { "color": "#666666", "font_style": "italic" },
          "constant": { "color": "#1DCD9F" },
          "constructor": { "color": "#ffffff" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_style": "bold" },
          "enum": { "color": "#169976" },
          "function": { "color": "#ffffff" },
          "function.builtin": { "color": "#ffffff" },
          "function.definition": { "color": "#ffffff" },
          "function.method": { "color": "#ffffff" },
          "function.special.definition": { "color": "#ffffff" },
          "hint": { "color": "#555555", "font_style": "italic" },
          "keyword": { "color": "#1DCD9F", "font_style": "bold" },
          "label": { "color": "#1DCD9F" },
          "link_text": { "color": "#1DCD9F" },
          "link_uri": { "color": "#169976" },
          "number": { "color": "#1DCD9F" },
          "operator": { "color": "#ffffff" },
          "predictive": { "color": "#555555", "font_style": "italic" },
          "preproc": { "color": "#1DCD9F", "font_style": "bold" },
          "primary": { "color": "#ffffff" },
          "property": { "color": "#ffffff" },
          "punctuation": { "color": "#ffffff" },
          "punctuation.bracket": { "color": "#ffffff" },
          "punctuation.delimiter": { "color": "#ffffff" },
          "punctuation.list_marker": { "color": "#1DCD9F" },
          "punctuation.special": { "color": "#1DCD9F" },
          "string": { "color": "#1DCD9F" },
          "string.escape": { "color": "#169976" },
          "string.regex": { "color": "#1DCD9F" },
          "string.special": { "color": "#1DCD9F" },
          "string.special.symbol": { "color": "#1DCD9F" },
          "tag": { "color": "#1DCD9F" },
          "text.literal": { "color": "#1DCD9F" },
          "title": { "color": "#1DCD9F", "font_style": "bold" },
          "type": { "color": "#169976" },
          "type.builtin": { "color": "#169976" },
          "variable": { "color": "#ffffff" },
          "variable.special": { "color": "#1DCD9F" },
          "variant": { "color": "#169976" }
        }
      }
    }
  ]
}
